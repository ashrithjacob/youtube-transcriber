# Copy to .env and fill in. Only needed for --visuals.
OPENROUTER_API_KEY=
# Must accept image input (z-ai/glm-5.2 is text-only). Alternatives:
# google/gemini-3.5-flash-lite, qwen/qwen3-vl-30b-a3b-instruct, z-ai/glm-5v-turbo
OPENROUTER_VISION_MODEL=z-ai/glm-5.3-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=
OPENROUTER_X_TITLE=yt-transcriber
OPENROUTER_TIMEOUT_S=120

# Keyframe selection / cost guards
VISION_SCENE_THRESHOLD=0.3
VISION_MAX_GAP_S=60
VISION_DEDUP_DISTANCE=6
VISION_MAX_FRAMES=300
VISION_CONCURRENCY=8
